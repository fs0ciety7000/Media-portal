# Copy these values into Coolify environment variables before deploying.
# Generate DB_PASSWORD with a random alphanumeric value and keep it private.
STORAGE_DIR=./data/storage
DB_DIR=./data/database
DB_TYPE=postgres
WIZARR_IMAGE_VERSION=latest
DB_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_SECRET
DB_USERNAME=postgres
DB_HOST=wizarr_postgres
DB_NAME=wizarr
REDIS_HOST=redis
REDIS_PORT=6379
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211
TZ=Europe/Brussels
